{
  "name": "downbeat-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:components": "vitest run",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "test:coverage:engine": "node --experimental-test-coverage --test-coverage-include=\"downbeat/studio/src/**\" --test-coverage-lines=89 --test-coverage-branches=89 --test-coverage-functions=86 --test tests/*.test.mjs",
    "test:coverage:components": "vitest run --coverage",
    "test:coverage": "npm run test:coverage:engine && npm run test:coverage:components",
    "test:python": "node scripts/python.mjs -m unittest discover -s tests -v",
    "test:python:coverage": "node scripts/python.mjs -m coverage run && node scripts/python.mjs -m coverage report && node scripts/python.mjs -m coverage json",
    "perf:engine": "node tests/performance/engine.bench.mjs",
    "perf:check": "node --expose-gc --test tests/performance/retention.test.mjs && node tests/performance/engine.bench.mjs --check",
    "perf:studio": "npm run build && node tests/performance/studio.bench.mjs --check",
    "quality": "node scripts/quality.mjs",
    "lint:react": "oxlint downbeat/studio/src"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
