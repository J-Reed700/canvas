{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": [
    "downbeat/studio/**/*.ts",
    "downbeat/studio/**/*.tsx"
  ]
}
